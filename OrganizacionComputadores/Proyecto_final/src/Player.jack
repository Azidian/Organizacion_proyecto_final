/**
 * Player.jack
 * Representa al jugador controlado por teclado (W/A/S/D o flechas).
 *
 * SPRITES segun nivel (el jugador ES la presa):
 * Nivel 1 - Raton:  cara redonda con orejas grandes y bigotes finos
 * Nivel 2 - Ardilla: cara con mejillas abultadas y cola imaginada
 * Nivel 3 - Pajaro:  cara con pico triangular y copete
 *
 * Keycodes Jack:
 * 130=ArrowLeft  131=ArrowUp  132=ArrowRight  133=ArrowDown
 * 65='A'  68='D'  87='W'  83='S'
 * 97='a' 100='d' 119='w' 115='s'
 *
 * TIEMPOS: el jugador responde cada tick (16ms), es decir ~100ms efectivos
 * porque el game loop espera Sys.wait(16) y el jugador mueve a cada presion.
 */
class Player {

    field int  row, col;
    field Maze maze;
    field int  cellSize;
    field int  level;
    field int  moveDelay;   // ticks entre movimientos del jugador
    field int  moveTimer;
    field int  lastDir;     // Ultima tecla/direccion presionada
    field int  dirRow, dirCol; // Direccion de movimiento actual (para IA predictiva)

    /* ── Constructor ─────────────────────────────────────────────── */
    constructor Player new(Maze theMaze, int startRow, int startCol, int interval, int lvl) {
        let maze      = theMaze;
        let row       = startRow;
        let col       = startCol;
        let cellSize  = maze.getCellSize();
        let level     = lvl;
        let moveTimer = 0;
        let moveDelay = interval; // COMENTARIO: Ajustar velocidad compartida en Game.jack (interval)
        let lastDir   = 0;
        let dirRow    = 0;
        let dirCol    = 0;

        return this;
    }

    /* ── Getters ─────────────────────────────────────────────────── */
    method int getRow() { return row; }
    method int getCol() { return col; }
    method int getDirRow() { return dirRow; }
    method int getDirCol() { return dirCol; }

    /**
     * Mapea códigos de tecla a un valor de dirección lógico:
     * 1: Arriba, 2: Abajo, 3: Izquierda, 4: Derecha, 0: Ninguno/Otro
     */
    method int getDirectionFromKey(int k) {
        if ((k = 87) | (k = 119) | (k = 131)) { return 1; } // W / w / Flecha Arriba
        if ((k = 83) | (k = 115) | (k = 133)) { return 2; } // S / s / Flecha Abajo
        if ((k = 65) | (k = 97)  | (k = 130)) { return 3; } // A / a / Flecha Izquierda
        if ((k = 68) | (k = 100) | (k = 132)) { return 4; } // D / d / Flecha Derecha
        return 0;
    }

    /* ── Input y movimiento ──────────────────────────────────────── */
    method boolean handleInput() {
        var int key, dir;
        var int newRow, newCol;

        let key = Keyboard.keyPressed();
        let dir = getDirectionFromKey(key);

        // Si cambia de direccion, eliminamos instantáneamente el retardo
        if ((dir > 0) & (~(dir = lastDir))) {
            let moveTimer = moveDelay;
        }
        let lastDir = dir;

        let moveTimer = moveTimer + 1;
        if (moveTimer < moveDelay) { return false; }

        let newRow = row;
        let newCol = col;

        if (dir = 1) { let newRow = row - 1; }
        if (dir = 2) { let newRow = row + 1; }
        if (dir = 3) { let newCol = col - 1; }
        if (dir = 4) { let newCol = col + 1; }

        if (maze.isPassable(newRow, newCol)) {
            if (~((newRow = row) & (newCol = col))) {
                // Actualizar dirección del último movimiento exitoso
                let dirRow = newRow - row;
                let dirCol = newCol - col;

                do maze.drawCell(row, col);
                let row = newRow;
                let col = newCol;
                let moveTimer = 0;
                return true;
            }
        }
        return false;
    }

    /* ── Renderizado: selecciona sprite por nivel ─────────────────── */
    method void draw() {
        if (level = 1) { do drawRaton(); }
        if (level = 2) { do drawArdilla(); }
        if (level = 3) { do drawPajaro(); }
        return;
    }

    /* ─────────────────────────────────────────────────────────────
       SPRITE NIVEL 1: RATON
       Cara blanca redondeada, orejas circulares grandes, bigotes finos
       ───────────────────────────────────────────────────────────── */
    method void drawRaton() {
        var int px, py, cx, cy;
        let px = col * cellSize;
        let py = row * cellSize;
        let cx = cellSize / 2;
        let cy = cellSize / 2;

        // Cara blanca rellena (cuerpo principal)
        do Screen.setColor(false);
        do Screen.drawRectangle(px+3, py+4, px+cellSize-4, py+cellSize-3);

        // Orejas grandes circulares (dos circulos blancos arriba)
        do Screen.drawRectangle(px+1, py+1, px+5, py+5);
        do Screen.drawRectangle(px+cellSize-6, py+1, px+cellSize-2, py+5);

        // Borde negro de la cara
        do Screen.setColor(true);
        do Screen.drawLine(px+3, py+4, px+cellSize-4, py+4);
        do Screen.drawLine(px+3, py+cellSize-3, px+cellSize-4, py+cellSize-3);
        do Screen.drawLine(px+3, py+4, px+3, py+cellSize-3);
        do Screen.drawLine(px+cellSize-4, py+4, px+cellSize-4, py+cellSize-3);

        // Borde orejas
        do Screen.drawLine(px+1, py+1, px+5, py+1);
        do Screen.drawLine(px+1, py+5, px+5, py+5);
        do Screen.drawLine(px+1, py+1, px+1, py+5);
        do Screen.drawLine(px+5, py+1, px+5, py+5);
        do Screen.drawLine(px+cellSize-6, py+1, px+cellSize-2, py+1);
        do Screen.drawLine(px+cellSize-6, py+5, px+cellSize-2, py+5);
        do Screen.drawLine(px+cellSize-6, py+1, px+cellSize-6, py+5);
        do Screen.drawLine(px+cellSize-2, py+1, px+cellSize-2, py+5);

        // Ojos negros pequeños
        do Screen.drawRectangle(px+5, py+6, px+6, py+7);
        do Screen.drawRectangle(px+cellSize-7, py+6, px+cellSize-6, py+7);

        // Nariz (puntito negro)
        do Screen.drawRectangle(px+cx-1, py+9, px+cx, py+9);

        // Bigotes finos horizontales
        do Screen.drawLine(px+2, py+9, px+4, py+9);
        do Screen.drawLine(px+2, py+10, px+4, py+10);
        do Screen.drawLine(px+cellSize-5, py+9, px+cellSize-3, py+9);
        do Screen.drawLine(px+cellSize-5, py+10, px+cellSize-3, py+10);

        // Boca sonriente
        do Screen.drawLine(px+cx-2, py+11, px+cx, py+12);
        do Screen.drawLine(px+cx, py+12, px+cx+2, py+11);

        return;
    }

    /* ─────────────────────────────────────────────────────────────
       SPRITE NIVEL 2: ARDILLA
       Estilo Ultra Kawaii: Cola muy esponjosa, mejillas gorditas, 
       ojazos negros con brillo, y dientecitos tiernos.
       ───────────────────────────────────────────────────────────── */
    method void drawArdilla() {
        var int px, py, cx;
        let px = col * cellSize;
        let py = row * cellSize;
        let cx = cellSize / 2;

        // --- Cola super esponjosa (detrás) ---
        do Screen.setColor(true);
        do Screen.drawRectangle(px+10, py+1, px+15, py+12);
        // Suavizar bordes para hacerla redonda
        do Screen.setColor(false);
        do Screen.drawLine(px+14, py+1, px+15, py+2);
        do Screen.drawLine(px+14, py+11, px+15, py+12);
        // Textura esponjosa
        do Screen.drawLine(px+11, py+3, px+14, py+3);
        do Screen.drawLine(px+12, py+6, px+15, py+6);
        do Screen.drawLine(px+11, py+9, px+14, py+9);

        // --- Cara redondita (blanca) ---
        do Screen.setColor(true); // Borde
        do Screen.drawRectangle(px+2, py+5, px+13, py+14);
        do Screen.setColor(false); // Relleno
        do Screen.drawRectangle(px+3, py+6, px+12, py+13);

        // --- Mejillas muy regordetas ---
        do Screen.setColor(true);
        do Screen.drawRectangle(px+1, py+8, px+3, py+12); // Borde mejilla izq
        do Screen.drawRectangle(px+12, py+8, px+14, py+12); // Borde mejilla der
        do Screen.setColor(false);
        do Screen.drawRectangle(px+2, py+9, px+3, py+11); // Relleno mejilla izq
        do Screen.drawRectangle(px+12, py+9, px+13, py+11); // Relleno mejilla der

        // --- Orejitas tiernas ---
        do Screen.setColor(true);
        do Screen.drawRectangle(px+3, py+3, px+5, py+5);
        do Screen.drawRectangle(px+10, py+3, px+12, py+5);
        do Screen.setColor(false);
        do Screen.drawRectangle(px+4, py+4, px+4, py+4); // interior blanco
        do Screen.drawRectangle(px+11, py+4, px+11, py+4);

        // --- Ojazos gigantes tiernos ---
        do Screen.setColor(true);
        do Screen.drawRectangle(px+4, py+7, px+6, py+9); // 3x3 ojo
        do Screen.drawRectangle(px+9, py+7, px+11, py+9); 
        // Brillo (Glint) blanco
        do Screen.setColor(false);
        do Screen.drawRectangle(px+5, py+7, px+5, py+7);
        do Screen.drawRectangle(px+10, py+7, px+10, py+7);

        // --- Naricita ---
        do Screen.setColor(true);
        do Screen.drawLine(px+7, py+10, px+8, py+10);

        // --- Dientecitos (buck teeth) ---
        do Screen.setColor(true);
        do Screen.drawRectangle(px+6, py+11, px+9, py+13); // borde exterior
        do Screen.setColor(false);
        do Screen.drawRectangle(px+7, py+12, px+8, py+12); // centro blanco
        // linea negra divisoria
        do Screen.setColor(true);
        do Screen.drawLine(px+7, py+11, px+7, py+13); 

        return;
    }

    /* ─────────────────────────────────────────────────────────────
       SPRITE NIVEL 3: PAJARO
       Cara simetrica frontal, pico centrado hacia abajo, copete arriba
       ───────────────────────────────────────────────────────────── */
    method void drawPajaro() {
        var int px, py, cx, cy;
        let px = col * cellSize;
        let py = row * cellSize;
        let cx = cellSize / 2;
        let cy = cellSize / 2;

        // Copete (plumas arriba, centrado)
        do Screen.setColor(true);
        do Screen.drawLine(px+cx-2, py+2, px+cx, py);
        do Screen.drawLine(px+cx, py, px+cx+2, py+2);
        do Screen.drawLine(px+cx-1, py+3, px+cx, py+1);
        do Screen.drawLine(px+cx, py+1, px+cx+1, py+3);

        // Cara blanca ovalada (rectangulo principal)
        do Screen.setColor(false);
        do Screen.drawRectangle(px+2, py+3, px+cellSize-3, py+cellSize-2);

        // Borde cara
        do Screen.setColor(true);
        do Screen.drawLine(px+2, py+3, px+cellSize-3, py+3);
        do Screen.drawLine(px+2, py+cellSize-2, px+cellSize-3, py+cellSize-2);
        do Screen.drawLine(px+2, py+3, px+2, py+cellSize-2);
        do Screen.drawLine(px+cellSize-3, py+3, px+cellSize-3, py+cellSize-2);

        // Ojo Izquierdo simetrico
        do Screen.drawRectangle(px+4, py+5, px+6, py+7);
        do Screen.setColor(false);
        do Screen.drawRectangle(px+5, py+6, px+5, py+6);

        // Ojo Derecho simetrico
        do Screen.setColor(true);
        do Screen.drawRectangle(px+cellSize-7, py+5, px+cellSize-5, py+7);
        do Screen.setColor(false);
        do Screen.drawRectangle(px+cellSize-6, py+6, px+cellSize-6, py+6);

        // Pico triangular centrado apuntando hacia abajo
        do Screen.setColor(true);
        do Screen.drawLine(px+cx-2, py+8, px+cx+2, py+8);
        do Screen.drawLine(px+cx-2, py+8, px+cx, py+11);
        do Screen.drawLine(px+cx+2, py+8, px+cx, py+11);

        // Plumas del ala (lineas en la parte inferior, simetricas)
        do Screen.drawLine(px+3, py+cellSize-4, px+5, py+cellSize-3);
        do Screen.drawLine(px+cellSize-4, py+cellSize-4, px+cellSize-6, py+cellSize-3);

        return;
    }

    /* ── Destructor ──────────────────────────────────────────────── */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}