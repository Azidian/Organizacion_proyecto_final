/**
 * Game.jack
 * Controlador principal de Maze Intelligence - 3 niveles.
 */
class Game {

    /* ── Constantes de estado ────────────────────────────────────── */
    static int STATE_START;
    static int STATE_LEVEL_LIST;
    static int STATE_LEVEL;
    static int STATE_PLAYING;
    static int STATE_PAUSED;
    static int STATE_WIN;
    static int STATE_LOSE;
    static int STATE_VICTORY;

    /* ── Campos ──────────────────────────────────────────────────── */
    field Maze   maze;
    field Player player;
    field Enemy  enemy1;
    field Enemy  enemy2;     // solo en el nivel 3
    field int    state;
    field int    currentLevel;
    field int    exitRow, exitCol;
    field boolean hasSecondEnemy;
    
    // Nuevo campo para controlar la memoria y los reintentos
    field int attempts;

    /* ── Constructor ─────────────────────────────────────────────── */
    constructor Game new() {
        let STATE_START      = 0;
        let STATE_LEVEL_LIST = 7;
        let STATE_LEVEL      = 1;
        let STATE_PLAYING    = 2;
        let STATE_PAUSED     = 3;
        let STATE_WIN        = 4;
        let STATE_LOSE       = 5;
        let STATE_VICTORY    = 6;

        let currentLevel    = 1;
        let state           = STATE_START;
        let hasSecondEnemy  = false;
        let attempts        = 0; // Inicializamos los intentos (Maximo de intentos 2)
        let maze            = null;
        let player          = null;
        let enemy1          = null;
        let enemy2          = null;
        return this;
    }

    /* ── Ciclo principal ─────────────────────────────────────────── */
    method void run() {
        var boolean running;
        let running = true;

        while (running) {
            if (state = STATE_START)      { do handleStart(); }
            if (state = STATE_LEVEL_LIST) { do handleLevelList(); }
            if (state = STATE_LEVEL)      { do handleLevelIntro(); }
            if (state = STATE_PLAYING)    { do playTick(); }
            if (state = STATE_PAUSED)     { do handlePause(); }
            if (state = STATE_WIN)        { let running = handleLevelWin(); }
            if (state = STATE_LOSE)       { let running = handleGameOver(); }
            if (state = STATE_VICTORY)    { let running = handleVictory(); }
        }
        return;
    }

    /* ════════════════════════════════════════════════════════════
       MANEJADORES DE ESTADOS Y TRANSICIONES
       ════════════════════════════════════════════════════════════ */
    method void handleStart() {
        do UI.drawStart();
        let state = STATE_LEVEL_LIST;
        return;
    }

    method void handleLevelList() {
        do UI.drawLevelList();
        let currentLevel = 1;
        let attempts = 0; 
        do loadLevel(currentLevel);
        let state = STATE_LEVEL;
        return;
    }

    method void handleLevelIntro() {
        do UI.drawLevelIntro(currentLevel);
        do drawGameScreen();
        let state = STATE_PLAYING;
        return;
    }

    method void handlePause() {
        do UI.drawPause(currentLevel);
        do drawGameScreen();
        let state = STATE_PLAYING;
        return;
    }

    method boolean handleLevelWin() {
        var int key;
        let key = UI.drawLevelWin(currentLevel);
        
        if ((key = 81) | (key = 113)) { return false; } // Salir (Q)
        
        // Avanzar de nivel
        let currentLevel = currentLevel + 1;
        let attempts = 0; // Reinicia intentos al pasar el nivel exitosamente
        do loadLevel(currentLevel);
        let state = STATE_LEVEL;
        return true;
    }

    method boolean handleGameOver() {
        var int key;
        
        let attempts = attempts + 1;
        
        let key = UI.drawGameOver(currentLevel, attempts);
        
        // Limite de 1 intento adicional (2 intentos en total por nivel)
        if (attempts > 1) {
            return false; // Fuerza el cierre del juego porque se acabaron los intentos
        }
        
        if ((key = 82) | (key = 114)) { 
            do loadLevel(currentLevel);
            let state = STATE_LEVEL;
            return true;
        }
        
        return false; 
    }

    method boolean handleVictory() {
        var int key;
        let key = UI.drawVictory();

        // En la victoria total solo se puede presionar [Q] para salir
        return false;
    }

    /* ════════════════════════════════════════════════════════════
       LOGICA DE JUEGO Y CARGA
       ════════════════════════════════════════════════════════════ */
    method void loadLevel(int lvl) {
        var int pRow, pCol, e1Row, e1Col, e2Row, e2Col, interval, dist, distCol;
        var boolean found;
        var int enemyInterval, safeDist;

        if (~(maze = null))   { do maze.dispose(); }
        if (~(player = null)) { do player.dispose(); }
        if (~(enemy1 = null)) { do enemy1.dispose(); }
        if (~(enemy2 = null)) { do enemy2.dispose(); let enemy2 = null; }

        let hasSecondEnemy = false;
        let maze = Maze.new(lvl);
        let safeDist = 3;

        // El 'interval' determina los ticks entre movimientos del jugador y enemigos.
        // Un valor menor hace que el movimiento sea más rápido. Ambos comparten esta misma velocidad.
        if (lvl = 1) {
            let pRow = 1;  let pCol = 1;
            let exitRow = 1; let exitCol = 15;
            let interval = 8;
            let enemyInterval = 8;
        }
        if (lvl = 2) {
            let pRow = 1;  let pCol = 1; 
            let exitRow = 9; let exitCol = 15;
            let interval = 6;
            let enemyInterval = 6;
        }
        if (lvl = 3) {
            let pRow = 9;  let pCol = 1;
            let exitRow = 5; let exitCol = 15;
            let interval = 4; // Jugador
            let enemyInterval = 5; 
            let safeDist = 8; 
            let hasSecondEnemy = true;
        }

        // --- ZONA SEGURA (PARA ENEMY 1) ---
        let found = false;
        while (~found) {
            let e1Row = Random.nextInt(maze.getRows());
            let e1Col = Random.nextInt(maze.getCols());
            
            if (maze.isPassable(e1Row, e1Col)) {
                // Distancia Manhattan al jugador
                let dist = e1Row - pRow;
                if (dist < 0) { let dist = -dist; }
                let distCol = e1Col - pCol;
                if (distCol < 0) { let distCol = -distCol; }
                let dist = dist + distCol;
                
                // COMENTARIO: CONFIGURACIÓN DE ZONA SEGURA
                // Para cambiar el radio de la zona segura, cambiar el valor de safeDist.
                // Un radio de safeDist + 1 bloques requiere que dist > safeDist.
                if ((dist > safeDist) & (~((e1Row = exitRow) & (e1Col = exitCol)))) {
                    let found = true;
                }
            }
        }

        // ---  ZONA SEGURA (PARA ENEMY 2 - SOLO NIVEL 3) ---
        if (hasSecondEnemy) {
            let found = false;
            while (~found) {
                let e2Row = Random.nextInt(maze.getRows());
                let e2Col = Random.nextInt(maze.getCols());
                
                if (maze.isPassable(e2Row, e2Col)) {
                    // Distancia Manhattan al jugador
                    let dist = e2Row - pRow;
                    if (dist < 0) { let dist = -dist; }
                    let distCol = e2Col - pCol;
                    if (distCol < 0) { let distCol = -distCol; }
                    let dist = dist + distCol;
                    
                    // Garantiza que la segunda serpiente respete la distancia mínima
                    if ((dist > safeDist) & (~((e2Row = exitRow) & (e2Col = exitCol))) & (~((e2Row = e1Row) & (e2Col = e1Col)))) {
                        let found = true;
                    }
                }
            }
        }

        let player = Player.new(maze, pRow, pCol, interval, lvl);
        let enemy1 = Enemy.new(maze, e1Row, e1Col, enemyInterval, 1, lvl);

        if (hasSecondEnemy) {
            let enemy2 = Enemy.new(maze, e2Row, e2Col, enemyInterval, 1, lvl);
        }
        return;
    }

    method void playTick() {
        if ((Keyboard.keyPressed() = 80) | (Keyboard.keyPressed() = 112)) {
            while ((Keyboard.keyPressed() = 80) | (Keyboard.keyPressed() = 112)) { }
            let state = STATE_PAUSED;
            return;
        }

        do player.handleInput();
        do enemy1.update(player.getRow(), player.getCol(), player.getDirRow(), player.getDirCol());
        if (hasSecondEnemy) { do enemy2.update(player.getRow(), player.getCol(), player.getDirRow(), player.getDirCol()); }

        do drawExit();
        do player.draw();
        do enemy1.draw();
        if (hasSecondEnemy) { do enemy2.draw(); }

        if ((player.getRow() = enemy1.getRow()) & (player.getCol() = enemy1.getCol())) {
            let state = STATE_LOSE;
        }
        if (hasSecondEnemy) {
            if ((player.getRow() = enemy2.getRow()) & (player.getCol() = enemy2.getCol())) {
                let state = STATE_LOSE;
            }
        }
        if ((player.getRow() = exitRow) & (player.getCol() = exitCol)) {
            if (currentLevel = 3) { let state = STATE_VICTORY; } 
            else { let state = STATE_WIN; }
        }

        do Sys.wait(16);
        return;
    }

    /* ──  Activo del Nivel ────────────────────────────── */
    method void drawGameScreen() {
        do Screen.clearScreen();
        do maze.draw();
        do drawExit();
        do player.draw();
        do enemy1.draw();
        if (hasSecondEnemy) { do enemy2.draw(); }
        return;
    }

    method void drawExit() {
        var int px, py, cs;
        let cs = maze.getCellSize();
        let px = exitCol * cs;
        let py = exitRow * cs;

        do Screen.setColor(false);
        do Screen.drawRectangle(px+1, py+1, px+cs-2, py+cs-2);
        do Screen.setColor(true);
        do Screen.drawLine(px+2, py+2, px+cs-3, py+cs-3);
        do Screen.drawLine(px+cs-3, py+2, px+2, py+cs-3);
        return;
    }

    /* ── Destructor ──────────────────────────────────────────────── */
    method void dispose() {
        if (~(maze = null))   { do maze.dispose(); }
        if (~(player = null)) { do player.dispose(); }
        if (~(enemy1 = null)) { do enemy1.dispose(); }
        if (~(enemy2 = null)) { do enemy2.dispose(); }
        do Memory.deAlloc(this);
        return;
    }
}