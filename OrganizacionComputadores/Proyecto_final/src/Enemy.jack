/**
 * Enemy.jack
 * Agente enemigo con IA basado en distancia Manhattan (heurística greedy).
 *
 * Estructura principal de la clase encargada del comportamiento,
 * movimiento autónomo y renderizado del adversario.
 *
 * Lógica de persecución:
 * Evalúa vecinos disponibles (arriba, abajo, izquierda, derecha) y elige 
 * el que minimice la distancia al jugador.
 * El movimiento se regula mediante un temporizador (ticks) para ajustar la dificultad.
 */

class Enemy {
    field int row, col;
    field int cellSize;

    constructor Enemy new(Maze theMaze, int startRow, int startCol) {
        let row = startRow;
        let col = startCol;
        return this;
    }

    method int getRow() { return row; }
    method int getCol() { return col; }

    /** IA del enemigo (Vacía para Fase 1) */
    method void update(int pRow, int pCol) {
        return;
    }

    /** Renderizado del enemigo (Vacío o básico para Fase 1) */
    method void draw() {
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}