        do Screen.drawRectangle(px+10, py+6, px+11, py+7);
        do Screen.setColor(true);
        do Screen.drawLine(px+8, py+12, px+8, py+15);
        do Screen.drawLine(px+8, py+14, px+6, py+16);
        do Screen.drawLine(px+8, py+14, px+10, py+16);
        do Screen.setColor(false);
        do Screen.drawLine(px+1, py+9, px+3, py+10);
        do Screen.drawLine(px+14, py+9, px+12, py+10);
        return;
    }

    function void drawPajaroIcon(int px, int py) {
        do Screen.setColor(true);
