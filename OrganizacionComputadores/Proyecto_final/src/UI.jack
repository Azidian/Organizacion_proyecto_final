        do Screen.drawRectangle(px+12, py+8, px+14, py+12);
        do Screen.setColor(false);
        do Screen.drawRectangle(px+2, py+9, px+3, py+11);
        do Screen.drawRectangle(px+12, py+9, px+13, py+11);
        do Screen.setColor(true);
        do Screen.drawRectangle(px+3, py+3, px+5, py+5);
        do Screen.drawRectangle(px+10, py+3, px+12, py+5);
        do Screen.setColor(false);
        do Screen.drawRectangle(px+4, py+4, px+4, py+4);
        do Screen.drawRectangle(px+11, py+4, px+11, py+4);
        do Screen.setColor(true);
        do Screen.drawRectangle(px+4, py+7, px+6, py+9);
        do Screen.drawRectangle(px+9, py+7, px+11, py+9);
        do Screen.setColor(false);
        do Screen.drawRectangle(px+5, py+7, px+5, py+7);
        do Screen.drawRectangle(px+10, py+7, px+10, py+7);
        do Screen.setColor(true);
        do Screen.drawLine(px+7, py+10, px+8, py+10);
        do Screen.drawRectangle(px+6, py+11, px+9, py+13);
        do Screen.setColor(false);
        do Screen.drawRectangle(px+7, py+12, px+8, py+12);
        do Screen.setColor(true);
        do Screen.drawLine(px+7, py+11, px+7, py+13);
        return;
    }

    function void drawSerpienteIcon(int px, int py) {
        do Screen.setColor(true);
        do Screen.drawRectangle(px+1, py+3, px+14, py+13);
        do Screen.drawRectangle(px+3, py+1, px+12, py+15);
