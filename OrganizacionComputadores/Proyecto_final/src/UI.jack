    /* ── PIXEL ART: G A M E  O V E R ── */
    function void drawGameOverTitle() {
        var int x, y;
        do Screen.setColor(true);
        let y = 50;
        
        // G
        let x = 168;
        do Screen.drawRectangle(x, y, x+12, y+3);
        do Screen.drawRectangle(x, y, x+3, y+20);
        do Screen.drawRectangle(x, y+17, x+12, y+20);
        do Screen.drawRectangle(x+9, y+10, x+12, y+20);
        do Screen.drawRectangle(x+6, y+10, x+12, y+13);
        // A
        let x = 188;
        do Screen.drawRectangle(x, y, x+3, y+20);
        do Screen.drawRectangle(x+9, y, x+12, y+20);
        do Screen.drawRectangle(x, y, x+12, y+3);
        do Screen.drawRectangle(x, y+9, x+12, y+12);
        // M
        let x = 208;
        do Screen.drawRectangle(x, y, x+3, y+20);
        do Screen.drawRectangle(x+12, y, x+15, y+20);
        do Screen.drawRectangle(x+3, y, x+6, y+5);
        do Screen.drawRectangle(x+6, y+5, x+9, y+10);
        do Screen.drawRectangle(x+9, y, x+12, y+5);
        // E
        let x = 233;
        do Screen.drawRectangle(x, y, x+3, y+20);
        do Screen.drawRectangle(x, y, x+12, y+3);
        do Screen.drawRectangle(x, y+9, x+10, y+12);
        do Screen.drawRectangle(x, y+17, x+12, y+20);

        // O
        let x = 273;
        do Screen.drawRectangle(x, y, x+3, y+20);
        do Screen.drawRectangle(x+9, y, x+12, y+20);
        do Screen.drawRectangle(x, y, x+12, y+3);
        do Screen.drawRectangle(x, y+17, x+12, y+20);
        // V
        let x = 293;
        do Screen.drawRectangle(x, y, x+3, y+15);
        do Screen.drawRectangle(x+9, y, x+12, y+15);
        do Screen.drawRectangle(x+3, y+15, x+9, y+20);
        // E
        let x = 313;
        do Screen.drawRectangle(x, y, x+3, y+20);
        do Screen.drawRectangle(x, y, x+12, y+3);
        do Screen.drawRectangle(x, y+9, x+10, y+12);
        do Screen.drawRectangle(x, y+17, x+12, y+20);
        // R
        let x = 333;
        do Screen.drawRectangle(x, y, x+3, y+20);
        do Screen.drawRectangle(x, y, x+12, y+3);
        do Screen.drawRectangle(x+9, y, x+12, y+12);
        do Screen.drawRectangle(x, y+9, x+12, y+12);
        do Screen.drawRectangle(x+6, y+12, x+9, y+16);
        do Screen.drawRectangle(x+9, y+16, x+12, y+20);
        return;
    }

    /* ── PIXEL ART: ¡ V I C T O R I A ! ── */
    function void drawVictoryTitle() {
        var int x, y;
        do Screen.setColor(true);
        let y = 50;
        
        // ¡
        let x = 165;
        do Screen.drawRectangle(x, y, x+4, y+4);
        do Screen.drawRectangle(x, y+8, x+4, y+20);
        // V
        let x = 180;
        do Screen.drawRectangle(x, y, x+3, y+15);
        do Screen.drawRectangle(x+9, y, x+12, y+15);
        do Screen.drawRectangle(x+3, y+15, x+9, y+20);
        // I
        let x = 200;
        do Screen.drawRectangle(x+4, y, x+7, y+20);
        // C
        let x = 215;
        do Screen.drawRectangle(x, y, x+3, y+20);
        do Screen.drawRectangle(x, y, x+12, y+3);
        do Screen.drawRectangle(x, y+17, x+12, y+20);
        // T
        let x = 235;
        do Screen.drawRectangle(x, y, x+12, y+3);
        do Screen.drawRectangle(x+4, y, x+7, y+20);
        // O
        let x = 255;
        do Screen.drawRectangle(x, y, x+3, y+20);
        do Screen.drawRectangle(x+9, y, x+12, y+20);
        do Screen.drawRectangle(x, y, x+12, y+3);
        do Screen.drawRectangle(x, y+17, x+12, y+20);
        // R
        let x = 275;
        do Screen.drawRectangle(x, y, x+3, y+20);
        do Screen.drawRectangle(x, y, x+12, y+3);
        do Screen.drawRectangle(x+9, y, x+12, y+12);
        do Screen.drawRectangle(x, y+9, x+12, y+12);
        do Screen.drawRectangle(x+6, y+12, x+9, y+16);
        do Screen.drawRectangle(x+9, y+16, x+12, y+20);
        // I
        let x = 295;
        do Screen.drawRectangle(x+4, y, x+7, y+20);
        // A
        let x = 310;
        do Screen.drawRectangle(x, y, x+3, y+20);
        do Screen.drawRectangle(x+9, y, x+12, y+20);
        do Screen.drawRectangle(x, y, x+12, y+3);
        do Screen.drawRectangle(x, y+9, x+12, y+12);
        // !
        let x = 330;
        do Screen.drawRectangle(x, y, x+4, y+12);
        do Screen.drawRectangle(x, y+16, x+4, y+20);
        return;
    }

    function void drawVersusIcons(int currentLevel, int py) {
        var int px1, px2;
        let px1 = 228; 
        let px2 = 268; 

        if (currentLevel = 1) {
            do UI.drawRatonIcon(px1, py);
            do UI.drawGatoIcon(px2, py);
        }
        if (currentLevel = 2) {
            do UI.drawArdillaIcon(px1, py);
            do UI.drawGatoIcon(px2, py);
        }
        if (currentLevel = 3) {
            do UI.drawPajaroIcon(px1, py);
            do UI.drawSerpienteIcon(px2, py);
        }
        return;
    }

    function void drawMiniIcons() {
        // Nivel 1 (Fila 1)
        do UI.drawRatonIcon(120, 74);
        do UI.drawGatoIcon(145, 74);
        // Nivel 2 (Fila 2)
        do UI.drawArdillaIcon(120, 118);
        do UI.drawGatoIcon(145, 118);
        // Nivel 3 (Fila 3)
        do UI.drawPajaroIcon(120, 162);
        do UI.drawSerpienteIcon(145, 162);
        return;
    }

    /* ════════════════════════════════════════════════════════════
       DIBUJO DE ICONOS (Mismos Sprites del Juego)
       ════════════════════════════════════════════════════════════ */
    function void drawRatonIcon(int px, int py) {
        do Screen.setColor(false);
        do Screen.drawRectangle(px+3, py+4, px+12, py+13);
        do Screen.drawRectangle(px+1, py+1, px+5, py+5);
        do Screen.drawRectangle(px+10, py+1, px+14, py+5);
        do Screen.setColor(true);
        do Screen.drawLine(px+3, py+4, px+12, py+4);
        do Screen.drawLine(px+3, py+13, px+12, py+13);
        do Screen.drawLine(px+3, py+4, px+3, py+13);
        do Screen.drawLine(px+12, py+4, px+12, py+13);
        do Screen.drawLine(px+1, py+1, px+5, py+1);
        do Screen.drawLine(px+1, py+5, px+5, py+5);
        do Screen.drawLine(px+1, py+1, px+1, py+5);
        do Screen.drawLine(px+5, py+1, px+5, py+5);
        do Screen.drawLine(px+10, py+1, px+14, py+1);
        do Screen.drawLine(px+10, py+5, px+14, py+5);
        do Screen.drawLine(px+10, py+1, px+10, py+5);
        do Screen.drawLine(px+14, py+1, px+14, py+5);
        do Screen.drawRectangle(px+5, py+6, px+6, py+7);
        do Screen.drawRectangle(px+9, py+6, px+10, py+7);
        do Screen.drawRectangle(px+7, py+9, px+8, py+9);
        do Screen.drawLine(px+2, py+9, px+4, py+9);
        do Screen.drawLine(px+2, py+10, px+4, py+10);
        do Screen.drawLine(px+11, py+9, px+13, py+9);
        do Screen.drawLine(px+11, py+10, px+13, py+10);
        do Screen.drawLine(px+6, py+11, px+8, py+12);
        do Screen.drawLine(px+8, py+12, px+10, py+11);
        return;
    }

    function void drawGatoIcon(int px, int py) {
        do Screen.setColor(true);
        do Screen.drawRectangle(px+2, py+5, px+13, py+14);
        do Screen.setColor(false);
        do Screen.drawLine(px+2, py+5, px+2, py+5);
        do Screen.drawLine(px+13, py+5, px+13, py+5);
        do Screen.drawLine(px+2, py+14, px+2, py+14);
        do Screen.drawLine(px+13, py+14, px+13, py+14);
        do Screen.setColor(true);
        do Screen.drawRectangle(px+3, py+2, px+6, py+4);
        do Screen.drawRectangle(px+9, py+2, px+12, py+4);
        do Screen.setColor(false);
        do Screen.drawLine(px+3, py+2, px+3, py+2); do Screen.drawLine(px+6, py+2, px+6, py+2);
        do Screen.drawLine(px+9, py+2, px+9, py+2); do Screen.drawLine(px+12, py+2, px+12, py+2);
        do Screen.drawRectangle(px+4, py+3, px+5, py+4);
        do Screen.drawRectangle(px+10, py+3, px+11, py+4);
        do Screen.drawRectangle(px+3, py+7, px+6, py+10);
        do Screen.drawRectangle(px+9, py+7, px+12, py+10);
        do Screen.setColor(true);
        do Screen.drawRectangle(px+4, py+8, px+5, py+9);
        do Screen.drawRectangle(px+10, py+8, px+11, py+9);
        do Screen.setColor(false);
        do Screen.drawLine(px+5, py+8, px+5, py+8);
        do Screen.drawLine(px+11, py+8, px+11, py+8);
        do Screen.setColor(true);
        do Screen.drawLine(px+7, py+11, px+8, py+11);
        do Screen.drawLine(px+7, py+12, px+8, py+12);
        do Screen.drawLine(px+6, py+13, px+7, py+13);
        do Screen.drawLine(px+8, py+13, px+9, py+13);
        do Screen.drawLine(px+1, py+10, px+2, py+10);
        do Screen.drawLine(px+1, py+11, px+2, py+11);
        do Screen.drawLine(px+13, py+10, px+14, py+10);
        do Screen.drawLine(px+13, py+11, px+14, py+11);
        return;
    }

    function void drawArdillaIcon(int px, int py) {
        do Screen.setColor(true);
        do Screen.drawRectangle(px+10, py+1, px+15, py+12);
        do Screen.setColor(false);
        do Screen.drawLine(px+14, py+1, px+15, py+2);
