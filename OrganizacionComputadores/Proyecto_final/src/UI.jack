        // S
        let x = 310;
        do Screen.drawRectangle(x, y, x+12, y+3);
        do Screen.drawRectangle(x, y, x+3, y+10);
        do Screen.drawRectangle(x, y+9, x+12, y+12);
        do Screen.drawRectangle(x+9, y+9, x+12, y+20);
        do Screen.drawRectangle(x, y+17, x+12, y+20);
        return;
    }

function void drawLargeNivelTitle(int num) {
        var int x, y;
        do Screen.setColor(true);
        let y = 45; 
        
        let x = 195; do Screen.drawRectangle(x, y, x+3, y+20); do Screen.drawRectangle(x+9, y, x+12, y+20); do Screen.drawLine(x+1, y, x+10, y+20);
        let x = 215; do Screen.drawRectangle(x+4, y, x+7, y+20);
        let x = 235; do Screen.drawRectangle(x, y, x+3, y+15); do Screen.drawRectangle(x+9, y, x+12, y+15); do Screen.drawRectangle(x+3, y+15, x+9, y+20);
        let x = 255; do Screen.drawRectangle(x, y, x+3, y+20); do Screen.drawRectangle(x, y, x+12, y+3); do Screen.drawRectangle(x, y+9, x+10, y+12); do Screen.drawRectangle(x, y+17, x+12, y+20);
        let x = 275; do Screen.drawRectangle(x, y, x+3, y+20); do Screen.drawRectangle(x, y+17, x+12, y+20);

        let x = 305;
        if (num = 1) { do Screen.drawRectangle(x+4, y, x+7, y+20); do Screen.drawRectangle(x, y, x+5, y+3); }
        if (num = 2) { do Screen.drawRectangle(x, y, x+12, y+3); do Screen.drawRectangle(x+9, y, x+12, y+10); do Screen.drawRectangle(x, y+9, x+12, y+12); do Screen.drawRectangle(x, y+10, x+3, y+20); do Screen.drawRectangle(x, y+17, x+12, y+20); }
        if (num = 3) { do Screen.drawRectangle(x, y, x+12, y+3); do Screen.drawRectangle(x+9, y, x+12, y+20); do Screen.drawRectangle(x, y+9, x+12, y+12); do Screen.drawRectangle(x, y+17, x+12, y+20); }
        return;
    }

    /* ── PIXEL ART GIGANTE PARA PAUSA (Actualizado para bajarlo un poco) ── */
