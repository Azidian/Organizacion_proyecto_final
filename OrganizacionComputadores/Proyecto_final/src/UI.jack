        // P
        let x = 195; do Screen.drawRectangle(x, y, x+3, y+20); do Screen.drawRectangle(x, y, x+12, y+3); do Screen.drawRectangle(x+9, y, x+12, y+10); do Screen.drawRectangle(x, y+9, x+12, y+12);
        // A
        let x = 215; do Screen.drawRectangle(x, y, x+3, y+20); do Screen.drawRectangle(x+9, y, x+12, y+20); do Screen.drawRectangle(x, y, x+12, y+3); do Screen.drawRectangle(x, y+9, x+12, y+12);
        // U
        let x = 235; do Screen.drawRectangle(x, y, x+3, y+20); do Screen.drawRectangle(x+9, y, x+12, y+20); do Screen.drawRectangle(x, y+17, x+12, y+20);
        // S
        let x = 255; do Screen.drawRectangle(x, y, x+12, y+3); do Screen.drawRectangle(x, y, x+3, y+10); do Screen.drawRectangle(x, y+9, x+12, y+12); do Screen.drawRectangle(x+9, y+9, x+12, y+20); do Screen.drawRectangle(x, y+17, x+12, y+20);
        // A
        let x = 275; do Screen.drawRectangle(x, y, x+3, y+20); do Screen.drawRectangle(x+9, y, x+12, y+20); do Screen.drawRectangle(x, y, x+12, y+3); do Screen.drawRectangle(x, y+9, x+12, y+12);
        return;
    }

